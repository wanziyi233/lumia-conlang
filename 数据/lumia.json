          "satelliteDistance": "主星 cell/2 + 卫星 cell/2 + 30",
          "clearance": 6,
          "bond": { "width": 0.8, "opacity": 0.24, "rule": "卫星连线须比句轨更细更淡（句轨 0.9 / 0.34）" }
        },
        "syllabary": { "cell": 30, "chainGap": 42, "rule": "首节坐句轨节点位，后续音节向句轨外侧依次延伸，并以同款较浅连线相接" },
        "rule": "附着物不参与句轨主路径；句轨只连词级节点"
