  "numerals": {
    "system": "十进制",
    "principle": "数词一词双义，无一纯数字词；数值义与实义按位置/语境判定",
    "counting": "数词系统共用到 13 个词（0–9 十个 + 10/100/1000 三个），它们全都在 lexicon 的 97 之内，不额外增加词数。注意三个易混的数字：① 系统用词 13 个；② 其中 cat=num 的只有 11 个（dua…kilo）；③ 另 2 个 vaka(0) 与 sola(1) 归在 cat=astro，因为它们的主义是「虚空」「太阳」。数字符（符号）则是 10 个：0–9 各有单符，10/100/1000 用位值横排写。",
    "digits": [
      { "value": 0, "w": "vaka", "concrete": "虚空/真空/空/无" },
      { "value": 1, "w": "sola", "concrete": "太阳/唯一" },
      { "value": 2, "w": "dua", "concrete": "双/对/成双" },
      { "value": 3, "w": "tia", "concrete": "群/聚/三体" },
      { "value": 4, "w": "teta", "concrete": "方/十字/四方" },
      { "value": 5, "w": "penta", "concrete": "手/掌/五芒" },
      { "value": 6, "w": "hesa", "concrete": "六方/蜂窝" },
      { "value": 7, "w": "heta", "concrete": "周/七曜/一星期" },
      { "value": 8, "w": "ota", "concrete": "八方/八分" },
      { "value": 9, "w": "enea", "concrete": "极多/众多" }
    ],
    "powers": [
      { "value": 10, "w": "deka", "concrete": "满环/完整周期" },
      { "value": 100, "w": "sento", "concrete": "星团/众多" },
      { "value": 1000, "w": "kilo", "concrete": "星海/无量" }
    ],
    "composition": "十进制位值并置：大位在前、小位在后，中间不加「和」。十位用 X deka Y，百/千位用 X sento Y / X kilo Y。位值为 0 的位在口语中略去（2025 读 dua kilo dua deka penta，0 百位不读），书写仍按位值横排补零。超过千的位由小幂乘大幂表达：10000 = deka kilo（10 × 1000）。",
    "examples": {
      "11": "deka sola",
      "21": "dua deka sola",
      "256": "dua sento penta deka hesa",
      "2025": "dua kilo dua deka penta",
      "10000": "deka kilo"
    }
  },
  "grammar": {
    "wordOrder": "SVO",
    "features": [
      "无屈折",
      "内容词一词多类（名/动/形由位置决定）",
      "修饰语后置（唯一例外：数词前置——dua luna 两个月亮、ota aka 八点）",
      "pi 重组修饰",
      "动词并列用逗号/停顿",
      "引语用 e 标记，直接后接引语",
      "情态动词后接动词作宾语，用 e 标记",
      "比较级 mako ku X，最高级 mako ala",
      "序数词 oba + 数词",
      "第一人称复数：mi mola = 我们（复用既有的 X mola「X 且多」构造，不新造词；含听众时用 mi en tu = 咱们）",
      "en 兼连分句（表并列）；转折无专门连词，让步用 la 框架（miko la, mi li kefa.）",
      "疑问词复用：ka lo=哪里，ka sema=何时，ka fo=为什么，ka pala=怎样",
      "是非问：正反并置 X no X（tu bena no bena? 你好吗？；komo li mako no mako? 宇宙大不大？）",
      "属格/来源用 fo（lumia fo sola 太阳的光），地点/存在用 lo（ena lo komo 宇宙中的人）；no 只作临时否定，固定反义词另有专词（malu 坏 / dama 暗）",
      "专名：首字母大写；置于类属词之后时用 na 标记（paneta na Satuna），直接作主语时不必加（Satuna li paneta ku oba.）；与核心词同形时（luna/Luna、vega/Vega），罗马化靠首字母大写区分，星文中靠「星符（内容词）vs 音节串（专名）」区分",
      "分数：X fo Y（Y 分之 X），如 sola fo dua = 二分之一"
    ],
    "particles": {
      "li": "谓语标记（主语为 mi/tu 时可省）",
      "e": "直接宾语标记",
      "la": "语境标记 X la Y",
      "pi": "修饰重组",
      "o": "呼格/祈愿/命令",
      "en": "和；也可连接分句（表并列）",
      "u": "或",
      "no": "否定（前置）",
      "ka": "疑问词",
      "wo": "向/给/为了",
      "fo": "从/因为/属于",
      "lo": "在/存在/是/对",
      "ku": "用/凭借/和",
      "na": "专名标记"
    },
    "pronouns": { "mi": "我", "tu": "你", "ta": "他/她/它/他们（无性无数）", "mi mola": "我们（我+多）", "mi en tu": "咱们（含听众）" },
    "tamMetaphor": [
