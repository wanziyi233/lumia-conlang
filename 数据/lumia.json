{
  "meta": {
    "name": "Lumia",
    "native": "露米亚",
    "gloss": "光",
    "ipa": "/ˈlu.mi.ɑ/",
    "version": "0.16.0",
    "purpose": "面向天文科幻社团的极简人造语（道本语式，娱乐向，偏科天文科幻）",
    "coreWordCount": 97,
    "designDecisions": [
      "语言名：Lumia（光）",
      "词汇规模：极简 ~97 核心词",
      "词源：天文/科幻词借希腊·拉丁；基础词自创 a priori",
      "音系：英式口音 + 简单五元音 a e i o u",
      "文字：表意 + 表音混合（Selagrafi 星文 · 星轨体一笔连写 + 星座体艺术排布）",
      "语法：道本语框架 + 科幻特色（天体隐喻时态）",
      "数字：十进制 + 天文意象；数词一词双义，无一纯数字词（0=vaka，1=sola）",
      "时间：全部复用现有词——一天=oba（圆），一小时=aka（圆上的一段弧），星期=sema na 天体名（七曜）",
      "偏科：刻意缺少厨房/球类/体育词汇",
      "文字破例：专名一般以音节串拼写，唯 Satuna（土星，社团主题）另配专属星符（实心圆盘+宽环带）——故天文词符表为 19 符，Satuna 的星符单列于 文字/符表.svg（副本见 文字/字形示例/satuna.svg；权威几何在 script.glyphs.word.Satuna）",
      "字形镜像对：luna（月亮）与 aka（弧）都是半圆，靠**鼓出方向**区分——月亮向左鼓（开口朝右），弧向右鼓（开口朝左）。这是刻意保留的形近，不要当 bug 去消除"
    ]
  },
  "phonology": {
    "vowels": [
      { "letter": "a", "ipa": "/ɑ/", "enRef": "father" },
      { "letter": "e", "ipa": "/ɛ/", "enRef": "dress" },
      { "letter": "i", "ipa": "/i/", "enRef": "fleece" },
      { "letter": "o", "ipa": "/ɒ/", "enRef": "lot" },
      { "letter": "u", "ipa": "/u/", "enRef": "goose" }
    ],
    "consonants": ["p","t","k","b","d","g","f","v","s","h","m","n","l","r","w","j"],
    "syllable": "(C)V(n)",
    "notes": [
      "无辅音丛、无双元音、元音相邻各成音节；n 可作音节尾（含词中与词末）",
      "音节尾辅音仅 n",
      "非卷舌：r 只在元音前，绝不作韵尾",
      "d/t 后跟 u 不发 yod（dua=/du.ɑ/）",
      "j=/j/（如 yes），非 /dʒ/"
    ],
    "stress": "词首音节，音高略升、响度略增，不区分长短",
    "loanAdaptation": {
      "rules": [
        "删去或调整词尾屈折（-us/-a/-ēs/-os 等）",
        "辅音丛删去其一或换位成 CV",
        "非 n 韵尾删除",
        "r 只出现在元音前；借词中处于音节尾或辅音前的 r 删除",
        "部分借词为缩合形式，不完全遵循上述规则；如 era（aēr）、sento（centum，按英式读音）、kilo（khilioi）"
      ],
      "examples": [
        { "source": "stella", "lumia": "sela", "gloss": "星", "how": "st→s，去 geminate l" },
        { "source": "sol", "lumia": "sola", "gloss": "太阳", "how": "+a" },
        { "source": "luna", "lumia": "luna", "gloss": "月亮", "how": "不变" },
        { "source": "planētēs", "lumia": "paneta", "gloss": "行星", "how": "pl→p，去词尾" },
        { "source": "kosmos", "lumia": "komo", "gloss": "宇宙", "how": "删 s" },
        { "source": "orbis", "lumia": "oba", "gloss": "轨道", "how": "删 r、去 -is" },
        { "source": "vacuus", "lumia": "vaka", "gloss": "虚空", "how": "缩合" },
        { "source": "pulsus", "lumia": "pusa", "gloss": "脉冲", "how": "删 l、去 -us" },
        { "source": "mikros", "lumia": "miko", "gloss": "小", "how": "kr→k" },
        { "source": "makros", "lumia": "mako", "gloss": "大", "how": "kr→k" },
        { "source": "energeia", "lumia": "enega", "gloss": "能量", "how": "删 r、缩 ia" },
        { "source": "aēr", "lumia": "era", "gloss": "大气", "how": "缩合" },
        { "source": "Saturnus", "lumia": "Satuna", "gloss": "土星", "how": "去 -us" },
        { "source": "Mercurius", "lumia": "Mekuria", "gloss": "水星", "how": "去 -ius、缩合" }
      ]
    }
  },
